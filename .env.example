# Chunking (~600 tokens / ~120 token overlap) — re-upload PDFs after changing
CHUNK_SIZE=2400
CHUNK_OVERLAP=480

# Ingestion performance
PDF_EXTRACTION_WORKERS=8
CHUNKING_WORKERS=8
EMBEDDING_BATCH_SIZE=512
EMBEDDING_DEVICE=cuda
CHROMA_INDEX_BATCH_SIZE=1024

# RAG retrieval pipeline
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-large
HYBRID_RETRIEVAL_ENABLED=true
ENABLE_QUERY_REWRITE_LLM=false
ENTITY_BOOST_WEIGHT=0.08
ENABLE_ANSWER_VERIFICATION=true
VERIFICATION_CACHE_SIZE=512
SKIP_VERIFICATION_AUTHORITATIVE_DEFINITIONS=true
ENABLE_ANSWER_REWRITE=true
ENABLE_EVIDENCE_SUFFICIENCY_GATE=true
ENABLE_PROCEDURAL_REASONING=true
PROCEDURAL_MAX_STEPS=10
PROCEDURAL_RELEVANCE_THRESHOLD=0.08
ENABLE_REGISTER_DEFINITION_RESOLVER=true
MAX_PINNED_DEFINITION_CHUNKS=3
# Weighted coverage weights (definition/behavior/exceptions/interactions)
COVERAGE_WEIGHT_DEFINITION=0.35
COVERAGE_WEIGHT_BEHAVIOR=0.25
COVERAGE_WEIGHT_EXCEPTIONS=0.20
COVERAGE_WEIGHT_INTERACTIONS=0.20
COVERAGE_CONFIDENCE_HIGH=0.80
COVERAGE_CONFIDENCE_MEDIUM=0.50
DEFINITIONAL_BOOST_WEIGHT=0.12
UNSUPPORTED_CLAIM_THRESHOLD=0.30
LLM_TEMPERATURE_TECHNICAL=0.05

# LLM — Ollama default
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION_NAME=docintel_documents

DEBUG=false
